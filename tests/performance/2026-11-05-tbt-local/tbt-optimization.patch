diff --git a/capstonefall2026/src/components/MobileNavigation.js b/capstonefall2026/src/components/MobileNavigation.js
new file mode 100644
--- /dev/null
+++ b/capstonefall2026/src/components/MobileNavigation.js
@@ -0,0 +1,92 @@
+import {
+    Box,
+    Drawer,
+    IconButton,
+    List,
+    ListItem,
+    ListItemButton,
+    ListItemText,
+    Typography,
+} from "@mui/material";
+import CloseIcon from "@mui/icons-material/Close";
+import { Link as RouterLink } from "react-router-dom";
+
+function MobileNavigation({ open, onClose, navigation, pathname }) {
+    return (
+        <Drawer
+            anchor="right"
+            open={open}
+            onClose={onClose}
+            PaperProps={{
+                id: "mobile-navigation-paper",
+                sx: {
+                    width: {
+                        xs: "85%",
+                        sm: 360,
+                    },
+                },
+            }}
+        >
+            <Box component="nav" id="mobile-navigation" aria-label="Mobile navigation">
+                <Box
+                    sx={{
+                        display: "flex",
+                        alignItems: "center",
+                        justifyContent: "space-between",
+                        p: 2,
+                        borderBottom: "1px solid",
+                        borderColor: "divider",
+                    }}
+                >
+                    <Typography variant="h3" component="p">
+                        Menu
+                    </Typography>
+
+                    <IconButton onClick={onClose} aria-label="Close navigation menu">
+                        <CloseIcon />
+                    </IconButton>
+                </Box>
+
+                <List>
+                    {navigation.map((item) => {
+                        const active = pathname === item.path;
+
+                        return (
+                            <ListItem key={item.path} disablePadding>
+                                <ListItemButton
+                                    component={RouterLink}
+                                    to={item.path}
+                                    onClick={onClose}
+                                    selected={active}
+                                    aria-current={active ? "page" : undefined}
+                                    sx={{
+                                        minHeight: 56,
+                                        px: 3,
+                                        "&.Mui-selected": {
+                                            backgroundColor: "rgba(31, 112, 177, 0.12)",
+                                            borderLeft: "5px solid",
+                                            borderColor: "primary.main",
+                                        },
+                                        "&.Mui-selected:hover": {
+                                            backgroundColor: "rgba(31, 112, 177, 0.18)",
+                                        },
+                                    }}
+                                >
+                                    <ListItemText
+                                        primary={item.label}
+                                        primaryTypographyProps={{
+                                            fontSize: "1.125rem",
+                                            fontWeight: active ? 700 : 500,
+                                        }}
+                                    />
+                                </ListItemButton>
+                            </ListItem>
+                        );
+                    })}
+                </List>
+            </Box>
+        </Drawer>
+    );
+}
+
+export default MobileNavigation;
diff --git a/capstonefall2026/src/components/mobileNavigationLoader.js b/capstonefall2026/src/components/mobileNavigationLoader.js
new file mode 100644
--- /dev/null
+++ b/capstonefall2026/src/components/mobileNavigationLoader.js
@@ -0,0 +1,14 @@
+let navigationPromise;
+
+// Fetch the drawer only when someone opens the mobile menu. A failed download
+// can be retried; successful downloads are shared across later openings.
+export function loadMobileNavigation() {
+    if (!navigationPromise) {
+        navigationPromise = import("./MobileNavigation").catch((error) => {
+            navigationPromise = undefined;
+            throw error;
+        });
+    }
+
+    return navigationPromise;
+}
