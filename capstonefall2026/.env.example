# Copy this file to .env.local and fill in sandbox/test values.
# Never commit a real .env file or production secrets to source control.

# Stripe (test/sandbox mode only — see documentation/api-contract.md,
# "Stripe Integration Boundary"). This is a publishable key, which is safe to
# expose to the browser, but it must always be a test-mode key ("pk_test_...")
# in this project. Never place a Stripe secret key in frontend source code.
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key

# Enables the Mock Service Worker sandbox layer in a deployed build
# (src/index.js enableMocking()). Always "true" for sandbox/demo deployments;
# leave unset for a real production build.
REACT_APP_ENABLE_MOCKS=true

# Canonical site origin used for SEO metadata (src/seo/metadata.js).
REACT_APP_SITE_URL=https://example.com
